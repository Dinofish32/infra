# Proxy image — runs proxy.py (load balancer + /metrics on 9999).
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies first so this layer is cached across code changes.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# proxy.py imports the metrics module and serves the /metrics chart page.
COPY proxy.py metrics.py metrics_page.html ./

RUN useradd --create-home appuser
USER appuser

EXPOSE 9999

CMD ["python", "proxy.py"]
